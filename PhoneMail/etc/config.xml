<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <phonemail>
            <general>
                <enabled>1</enabled>
                <email_domain>test.ghoste.com</email_domain>
                <phone_validation>1</phone_validation>
                <phone_length>11</phone_length>
                <phone_min_length>10</phone_min_length>
                <phone_max_length>15</phone_max_length>
            </general>
            <display>
                <show_phone_account>1</show_phone_account>
                <autofill_checkout>1</autofill_checkout>
            </display>
            <whatsapp>
                <enabled>0</enabled>
                <send_order_confirmation>1</send_order_confirmation>
                <send_shipping_update>1</send_shipping_update>
                <order_template>مرحباً {customer_name}، تم استلام طلبك رقم {order_id} بنجاح. المبلغ الإجمالي: {total}. شكراً لتسوقك معنا!</order_template>
                <shipping_template>مرحباً {customer_name}، تم شحن طلبك رقم {order_id}. رقم التتبع: {tracking_number}. شكراً لتسوقك معنا!</shipping_template>
            </whatsapp>
        </phonemail>
    </default>
</config>