<script>
// Fix form property directly as early as possible
document.addEventListener('DOMContentLoaded', function() {
    // Wait for validation to be loaded
    var checkInterval = setInterval(function() {
        if (window.jQuery && jQuery.validator) {
            clearInterval(checkInterval);
            
            // Save original valid method
            var originalValid = jQuery.fn.valid;
            
            // Override jQuery.fn.valid to handle undefined form
            jQuery.fn.valid = function() {
                try {
                    // Check if element exists and has form property
                    if (this.length === 0) {
                        console.warn('PhoneMail: Empty jQuery object in valid()');
                        return true;
                    }
                    
                    // If form is undefined, try to find closest form
                    if (this[0] && this[0].form === undefined) {
                        var closestForm = jQuery(this).closest('form')[0];
                        if (closestForm) {
                            this[0].form = closestForm;
                            console.log('PhoneMail: Fixed missing form property');
                        } else {
                            console.warn('PhoneMail: Cannot find form for validation');
                            return true; // Consider valid if we can't find form
                        }
                    }
                    
                    // Call original method
                    return originalValid.apply(this, arguments);
                } catch (e) {
                    console.error('PhoneMail: Error in valid() function', e);
                    return true;
                }
            };
            
            console.log('PhoneMail: Patched jQuery.fn.valid');
        }
    }, 100);
    
    // Also fix form property on all input elements periodically
    setInterval(function() {
        if (window.jQuery) {
            jQuery('input, select, textarea').each(function() {
                if (this.form === undefined) {
                    var form = jQuery(this).closest('form')[0];
                    if (form) {
                        this.form = form;
                    }
                }
            });
        }
    }, 1000);
}, false);
    // Apply direct fixes to avoid validation errors
    require(['jquery'], function($) {
        $(document).ready(function() {
            console.log('PhoneMail: Direct JS fixes running');
            
            // Add a try-catch wrapper around form validations
            var originalFormValidate = $.fn.validate;
            if (originalFormValidate) {
                $.fn.validate = function() {
                    try {
                        if (this.length === 0) {
                            console.warn('PhoneMail: Attempted to validate empty jQuery object');
                            return { 
                                valid: function() { return true; },
                                form: function() { return true; }
                            };
                        }
                        return originalFormValidate.apply(this, arguments);
                    } catch (e) {
                        console.error('PhoneMail: Error in validate() function', e);
                        return { 
                            valid: function() { return true; },
                            form: function() { return true; }
                        };
                    }
                };
            }
            
            // Add a try-catch wrapper around form valid() method
            var originalValid = $.fn.valid;
            if (originalValid) {
                $.fn.valid = function() {
                    try {
                        if (this.length === 0) {
                            console.warn('PhoneMail: Attempted valid() on empty jQuery object');
                            return true;
                        }
                        return originalValid.apply(this, arguments);
                    } catch (e) {
                        console.error('PhoneMail: Error in valid() function', e);
                        return true;
                    }
                };
            }
            
            // Monitor the form to ensure telephone field is processed correctly
            function processCheckoutForms() {
                // Find all telephone fields
                var telephoneFields = $('input[name="telephone"], input[name$=".telephone"]');
                
                telephoneFields.each(function() {
                    var field = $(this);
                    var fieldContainer = field.closest('.field');
                    
                    // Add phone note if missing
                    if (fieldContainer.find('.phonemail-note').length === 0) {
                        fieldContainer.append(
                            '<div class="phonemail-note" style="color:#666;font-size:12px;font-style:italic;margin-top:5px;">' +
                            'Your email address will be generated automatically from your phone number' +
                            '</div>'
                        );
                    }
                    
                    // Ensure field has proper validation
                    if (!field.attr('data-validate')) {
                        field.attr('data-validate', '{"required":true, "validate-phone-number":true}');
                    }
                });
                
                // Update email whenever telephone changes
                telephoneFields.off('change.phonemail').on('change.phonemail', function() {
                    var phone = $(this).val();
                    if (phone) {
                        var cleanPhone = phone.replace(/\D/g, '');
                        if (cleanPhone.length >= 6) {
                            var domain = window.location.hostname.replace('www.', '');
                            var email = cleanPhone + '@' + domain;
                            
                            // Set email in any input fields
                            $('input[type="email"]').val(email);
                            
                            // Update quote if available
                            if (typeof window.checkoutConfig !== 'undefined') {
                                try {
                                    require([
                                        'Magento_Checkout/js/model/quote',
                                        'Magento_Checkout/js/checkout-data'
                                    ], function(quote, checkoutData) {
                                        quote.guestEmail = email;
                                        
                                        var shippingAddress = quote.shippingAddress();
                                        if (shippingAddress) {
                                            shippingAddress.email = email;
                                            quote.shippingAddress(shippingAddress);
                                        }
                                        
                                        checkoutData.setInputFieldEmailValue(email);
                                        checkoutData.setValidatedEmailValue(email);
                                        
                                        console.log('PhoneMail: Updated checkout data with email: ' + email);
                                    });
                                } catch (e) {
                                    console.error('PhoneMail: Error updating quote', e);
                                }
                            }
                        }
                    }
                });
            }
            
            // Run immediately and also after a delay to catch dynamically added fields
            processCheckoutForms();
            setTimeout(processCheckoutForms, 1000);
            setTimeout(processCheckoutForms, 3000);
            
            // Set interval to ensure forms are correctly processed
            setInterval(processCheckoutForms, 5000);
            
            // Also handle continue button clicks more robustly
            $(document).on('click', '.button.action.continue.primary', function(e) {
                try {
                    var form = $(this).closest('form');
                    if (form.length === 0) {
                        return; // Let default handler run
                    }
                    
                    // Get telephone field
                    var telephoneField = $('input[name="telephone"], input[name$=".telephone"]').first();
                    if (telephoneField.length && !telephoneField.val()) {
                        // Telephone is empty, show error
                        telephoneField.addClass('mage-error');
                        if ($('#telephone-error').length === 0) {
                            telephoneField.after('<div id="telephone-error" class="mage-error">This is a required field.</div>');
                        }
                        e.preventDefault();
                        e.stopPropagation();
                        return false;
                    }
                    
                    // Update email from telephone
                    var phone = telephoneField.val();
                    if (phone) {
                        var cleanPhone = phone.replace(/\D/g, '');
                        if (cleanPhone.length >= 6) {
                            var domain = window.location.hostname.replace('www.', '');
                            var email = cleanPhone + '@' + domain;
                            
                            // Set email in any input fields
                            $('input[type="email"]').val(email);
                            
                            // Update checkout data if available
                            if (typeof window.checkoutConfig !== 'undefined') {
                                try {
                                    require([
                                        'Magento_Checkout/js/model/quote',
                                        'Magento_Checkout/js/checkout-data'
                                    ], function(quote, checkoutData) {
                                        quote.guestEmail = email;
                                        
                                        var shippingAddress = quote.shippingAddress();
                                        if (shippingAddress) {
                                            shippingAddress.email = email;
                                            quote.shippingAddress(shippingAddress);
                                        }
                                        
                                        checkoutData.setInputFieldEmailValue(email);
                                        checkoutData.setValidatedEmailValue(email);
                                        
                                        console.log('PhoneMail: Updated checkout data with email: ' + email);
                                    });
                                } catch (e) {
                                    console.error('PhoneMail: Error updating quote', e);
                                }
                            }
                        }
                    }
                } catch (error) {
                    console.error('PhoneMail: Error handling continue button', error);
                }
            });
        });
    });
</script>
