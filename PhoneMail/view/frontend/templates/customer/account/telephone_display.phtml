// استخراج رقم الهاتف من البريد الإلكتروني
$customerEmail = $block->getCustomer()->getEmail();
$telephone = '';

// استخراج رقم الهاتف من البريد الإلكتروني (إذا كان بالتنسيق المتوقع)
if (strpos($customerEmail, '@') !== false) {
    $parts = explode('@', $customerEmail);
    $telephone = $parts[0];
}
?>

<?php if ($telephone): ?>
<div class="box-information">
    <strong class="box-title">
        <span><?= $block->escapeHtml(__('Phone Number')) ?></span>
    </strong>
    <div class="box-content">
        <p><?= $block->escapeHtml($telephone) ?></p>
    </div>
</div>
<?php endif; ?>